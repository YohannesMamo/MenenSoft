# Copy to backend/.env and fill in real values. Never commit the real .env.

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security
SECRET_KEY=change-me

# Application
ENVIRONMENT=production          # use "development" to allow localhost email links
DEBUG=False
APP_NAME=MERP Student Assistant
# Public frontend URL used in verification / password-reset links.
FRONTEND_URL=https://menenoshs.onrender.com

# ------------------ EMAIL (Brevo) ------------------
# Preferred transport: Brevo HTTP API (HTTPS/443, works on Render free tier).
# The key must belong to the same Brevo account as the verified sender, and the
# calling server IP must be allowed in Brevo -> Security -> Authorised IPs.
BREVO_API_KEY=

# Sender must be a verified sender in Brevo -> Senders & IP.
FROM_EMAIL=calebbenyofoni2@mail.brevosend.com
FROM_NAME=MERP Student Assistant

# Mailbox that receives contact-form submissions (a real inbox!).
CONTACT_RECIPIENT_EMAIL=

# Optional SMTP fallback (only works where outbound SMTP is not blocked).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
